# Copie para ".env" e preencha. O ".env" NÃO vai para o Git.

# Banco (em desenvolvimento, o compose.yaml sobe um Postgres com estes valores)
DB_URL=jdbc:postgresql://localhost:5432/abrigo
DB_USER=abrigo
DB_PASSWORD=abrigo

# Primeiro usuário (criado só se o banco não tiver nenhum usuário)
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=

# Endereço público do site (usado nas prévias do WhatsApp)
URL_PUBLICA=http://localhost:8080

# Onde as fotos são gravadas (implementação local, até decidir a hospedagem)
ARMAZENAMENTO_DIR=./dados/arquivos

# Produção: true (cookie só trafega em HTTPS)
COOKIE_SECURE=false

# Antispam do formulário público
SOLICITACOES_LIMITE_HORA=5
